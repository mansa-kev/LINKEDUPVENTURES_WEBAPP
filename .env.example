# ─── Client (exposed to browser via Vite) ─────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# ─── Server-only (NEVER prefix with VITE_) ────────────────────────────
# Used by api/index.ts serverless function on Vercel.
# Get from: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── NCBA STK Push (server-only) ──────────────────────────────────────
NCBA_BASE_URL=https://c2bapis.ncbagroup.com
NCBA_USERNAME=
NCBA_PASSWORD=
NCBA_PAYBILL_NO=
NCBA_ACCOUNT_NO=
NCBA_NETWORK=Safaricom
NCBA_TRANSACTION_TYPE=CustomerPayBillOnline
NCBA_TOKEN_METHOD=GET
