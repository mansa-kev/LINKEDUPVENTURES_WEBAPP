# ─── Client (exposed to browser via Vite) ─────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# ─── Server-only (NEVER prefix with VITE_) ────────────────────────────
# Required on Vercel: Project Settings → Environment Variables
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Legacy alias also supported: SB_SERVICE_ROLE_KEY

# ─── Resend (transactional email — server /api/email/send) ────────────
# From address is fixed: noreply@office.linkedupcarsrentals.com
RESEND_API_KEY=your-resend-api-key

# ─── NCBA STK Push (server-only) ──────────────────────────────────────
NCBA_BASE_URL=https://c2bapis.ncbagroup.com
NCBA_USERNAME=
NCBA_PASSWORD=
NCBA_PAYBILL_NO=
NCBA_ACCOUNT_NO=1006230208
NCBA_NETWORK=Safaricom
NCBA_TRANSACTION_TYPE=CustomerPayBillOnline
NCBA_TOKEN_METHOD=GET
