# ─── Client (exposed to browser via Vite) ─────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# ─── Server / Vercel API (api/index.ts) ─────────────────────────────
# Set ALL of these on Vercel (Production + Preview). VITE_* alone may not
# reach serverless functions at runtime — use the non-VITE names too.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Legacy aliases also supported: SB_SERVICE_ROLE_KEY, VITE_SUPABASE_SERVICE_ROLE_KEY

# ─── Resend (transactional email — server /api/email/send) ────────────
# From address is fixed: noreply@office.linkedupcarsrentals.com
RESEND_API_KEY=your-resend-api-key

# ─── NCBA STK Push (server-only) ──────────────────────────────────────
NCBA_BASE_URL=https://c2bapis.ncbagroup.com
NCBA_USERNAME=
NCBA_PASSWORD=
NCBA_PAYBILL_NO=
NCBA_ACCOUNT_NO=1006230208
NCBA_NETWORK=Safaricom
NCBA_TRANSACTION_TYPE=CustomerPayBillOnline
NCBA_TOKEN_METHOD=GET
